        "smarty/smarty": "^4.5.7",
        "mailgun/mailgun-php": "^4.3",
        "predis/predis": "^2.3",
        "phpmailer/phpmailer": "~6.0",
        "firebase/php-jwt": "^7.0",
        "aws/aws-sdk-php": "^3.371.4",
        "gregwar/captcha": "1.*",
        "voku/anti-xss": "^4.1",
        "paymentwall/paymentwall-php": "^2.1",
        "telegram-bot/api": "^2.2",
        "illuminate/pagination": "^12.0",
        "illuminate/database": "^12.0",
        "sendgrid/sendgrid": "~7",
        "esdeathlove/datatables": "^1.6",
        "ramsey/uuid": "^4.9",
        "guzzlehttp/guzzle": "^7.15.2",
        "league/omnipay": "^3",
        "lokielse/omnipay-alipay": "3.0.6-security",
